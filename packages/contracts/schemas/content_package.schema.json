{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/content_package.schema.json",
  "title": "Content package contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "title",
    "category",
    "age_tiers",
    "asset_key",
    "sha256",
    "size_bytes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "category": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/content_category"
    },
    "age_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/age_tier"
      }
    },
    "asset_key": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/object_key"
    },
    "sha256": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/sha256"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "published",
        "withdrawn",
        "archived"
      ]
    },
    "submitted_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "approved_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "approved_by": {
      "type": "string",
      "maxLength": 128
    },
    "published_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    }
  }
}
