{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/voice_control.schema.json",
  "title": "Realtime voice control frame",
  "description": "One JSON control frame exchanged over the device realtime WebSocket. Binary WebSocket messages carry Opus payloads; this schema only covers the JSON control channel so the device and the gateway agree on lifecycle and error handling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "session_id",
    "device_id",
    "sent_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "type": {
      "type": "string",
      "enum": [
        "session_start",
        "session_started",
        "session_state",
        "wake_detected",
        "session_end",
        "session_closed",
        "cancel",
        "barge_in",
        "quality_metrics",
        "error",
        "ping",
        "pong"
      ]
    },
    "session_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "device_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "sent_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking"
      ]
    },
    "stream_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "sample_rate_hz": {
      "type": "integer",
      "const": 16000
    },
    "channel_count": {
      "type": "integer",
      "const": 1
    },
    "duration_ms": {
      "type": "integer",
      "const": 20
    },
    "encoding": {
      "type": "string",
      "const": "opus"
    },
    "firmware_version": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
    },
    "wake_word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "wake_confidence_milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/device_capability"
      }
    },
    "expires_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "code": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "session_limit_reached",
        "session_not_found",
        "invalid_control_frame",
        "invalid_audio_frame",
        "frame_too_large",
        "rate_limited",
        "session_expired",
        "not_speaking",
        "barge_in_rejected",
        "transport_closed",
        "provider_unavailable",
        "internal_error"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "echo_convergence",
        "noise_floor",
        "agc_gain",
        "vad_confidence"
      ],
      "properties": {
        "echo_convergence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "noise_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agc_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "vad_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "session_start" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "stream_id": {},
          "sample_rate_hz": {},
          "channel_count": {},
          "duration_ms": {},
          "encoding": {},
          "firmware_version": {}
        },
        "required": [
          "stream_id",
          "sample_rate_hz",
          "channel_count",
          "duration_ms",
          "encoding",
          "firmware_version"
        ]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "wake_detected" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "stream_id": {},
          "wake_word": {},
          "wake_confidence_milli": {}
        },
        "required": [
          "stream_id",
          "wake_word",
          "wake_confidence_milli"
        ]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "session_started" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "expires_at": {}
        },
        "required": ["expires_at"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "session_state" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "state": {}
        },
        "required": ["state"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "barge_in" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "reason": {}
        },
        "required": ["reason"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "quality_metrics" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "quality": {}
        },
        "required": ["quality"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "error" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "code": {},
          "message": {},
          "retryable": {}
        },
        "required": ["code", "message", "retryable"]
      }
    }
  ]
}
