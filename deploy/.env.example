# Local-only development credentials. Copy this file to deploy/.env and replace
# every value before starting containers. Never commit deploy/.env.
SPROUT_POSTGRES_USER=sprout
SPROUT_POSTGRES_PASSWORD=replace-with-local-database-password
SPROUT_POSTGRES_DB=sprout
SPROUT_POSTGRES_PORT=5432
SPROUT_DEVICE_PLATFORM_DATABASE_NAME=sprout_device_platform
SPROUT_SUB2API_DATABASE_NAME=sprout_sub2api

SPROUT_REDIS_PASSWORD=replace-with-local-redis-password
SPROUT_REDIS_PORT=6379

SPROUT_MQTT_PORT=1883
SPROUT_MQTTS_PORT=8883

SPROUT_DEVICE_PLATFORM_PORT=8081
SPROUT_VOICE_GATEWAY_PORT=8082
SPROUT_ADMIN_WEB_PORT=8083
SPROUT_SUB2API_PORT=8080

# Container image versions. Leave these at local for source builds, or set
# them to the released semantic versions used by synchronize-docker.ps1.
SPROUT_PLATFORM_VERSION=local
SPROUT_SUB2API_VERSION=local

# Optional external API origin baked into the admin console bundle. Leave
# empty for the default same-origin Nginx proxy.
SPROUT_ADMIN_API_BASE_URL=
SPROUT_ADMIN_API_TIMEOUT_MS=15000
SPROUT_LOCAL_VERSION_CHECK_INTERVAL_SECONDS=300

# Shared secret for device_platform -> sub2api internal service API. Use a
# random value with at least 32 characters; never expose it to browsers or devices.
SPROUT_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# device_platform parent session signing and AI credential encryption keys.
SPROUT_AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
SPROUT_AUTH_ACCESS_TOKEN_TTL=15m
SPROUT_AUTH_REFRESH_TOKEN_TTL=720h
SPROUT_AI_CREDENTIAL_KEY=replace-with-at-least-32-random-characters
SPROUT_MFA_CREDENTIAL_KEY=replace-with-a-different-32-character-secret
SPROUT_MFA_CHALLENGE_TTL=5m
# Local-only SMS bypass: accepts an empty code or 000000. Production must use
# a real provider instead of enabling this mode.
SPROUT_PHONE_VERIFICATION_MODE=local
SPROUT_ALLOW_LOCAL_SMS_BYPASS=true
SPROUT_AI_DEFAULT_BALANCE_USD=0
SPROUT_AI_DEFAULT_CONCURRENCY=1
SPROUT_AI_DEFAULT_MODELS=

# Public object-storage prefixes for resource and client updates. Keep the
# bucket credentials on the server; these values only define the allowed URL
# prefixes sent to clients.
SPROUT_OTA_MANIFEST_BASE_URL=
SPROUT_OTA_RESOURCE_BASE_URL=
SPROUT_OTA_CLIENT_BASE_URL=
# JSON object mapping key ids to base64 Ed25519 public keys. Required before
# publishing signed remote UI text packages.
SPROUT_UI_TEXT_SIGNATURE_PUBLIC_KEYS=

SPROUT_SUB2API_API_KEY=replace-with-local-sub2api-key
SPROUT_SUB2API_ADMIN_EMAIL=admin@sprout.local
SPROUT_SUB2API_ADMIN_PASSWORD=replace-with-local-admin-password
SPROUT_SUB2API_JWT_SECRET=replace-with-at-least-32-random-hex-characters
SPROUT_SUB2API_TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-hex-characters
SPROUT_TIMEZONE=Asia/Shanghai
