{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/usage_report.schema.json",
  "title": "Guardian usage report day",
  "description": "One device-local usage day as shown to a guardian. Aggregates only counters and durations; never carries conversation text, audio, images, tokens, or child identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_date",
    "timezone_offset_minutes",
    "active_minutes",
    "conversation_count",
    "conversation_minutes",
    "content_play_count",
    "content_minutes",
    "daily_limit_minutes",
    "remaining_minutes",
    "limit_reached",
    "categories",
    "blocked",
    "devices",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "timezone_offset_minutes": {
      "type": "integer",
      "minimum": -840,
      "maximum": 840
    },
    "active_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "conversation_count": {
      "type": "integer",
      "minimum": 0
    },
    "conversation_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "content_play_count": {
      "type": "integer",
      "minimum": 0
    },
    "content_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "daily_limit_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 720
    },
    "remaining_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 720
    },
    "limit_reached": {
      "type": "boolean"
    },
    "categories": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/category_usage"
      }
    },
    "blocked": {
      "$ref": "#/$defs/blocked_counts"
    },
    "devices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/device_usage"
      }
    },
    "updated_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "category_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "play_count",
        "minutes"
      ],
      "properties": {
        "category": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/content_category"
        },
        "play_count": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "blocked_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disabled_period",
        "daily_limit",
        "category_denied",
        "time_untrusted"
      ],
      "properties": {
        "disabled_period": {
          "type": "integer",
          "minimum": 0
        },
        "daily_limit": {
          "type": "integer",
          "minimum": 0
        },
        "category_denied": {
          "type": "integer",
          "minimum": 0
        },
        "time_untrusted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "device_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_name",
        "active_minutes",
        "conversation_count",
        "content_play_count"
      ],
      "properties": {
        "device_id": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
        },
        "device_name": {
          "type": "string",
          "maxLength": 64
        },
        "active_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "conversation_count": {
          "type": "integer",
          "minimum": 0
        },
        "content_play_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
