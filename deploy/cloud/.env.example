# ============================================================================
# 如此萌屋云端部署环境变量
#
# 复制为 .env 后再修改。每行含义见同目录 README.md。
# 生产环境不要复用本文件中的占位值，也不要把 .env 提交到 Git。
# ============================================================================

# ---- PostgreSQL ----
SPROUT_POSTGRES_USER=sprout
SPROUT_POSTGRES_PASSWORD=replace-with-strong-random-password
SPROUT_POSTGRES_DB=sprout
SPROUT_DEVICE_PLATFORM_DATABASE_NAME=sprout_device_platform
SPROUT_SUB2API_DATABASE_NAME=sprout_sub2api

# ---- Redis ----
SPROUT_REDIS_PASSWORD=replace-with-strong-random-password

# ---- 服务端口与监听地址 ----
SPROUT_SERVICE_BIND_ADDRESS=127.0.0.1
SPROUT_MQTT_BIND_ADDRESS=127.0.0.1
SPROUT_MQTTS_BIND_ADDRESS=0.0.0.0
SPROUT_MQTT_UID=1883
SPROUT_MQTT_GID=1883
SPROUT_DEVICE_PLATFORM_UID=65532
SPROUT_DEVICE_PLATFORM_GID=65532
SPROUT_DEVICE_PLATFORM_PORT=8081
SPROUT_VOICE_GATEWAY_PORT=8082
SPROUT_ADMIN_WEB_PORT=8083
SPROUT_SUB2API_PORT=8084
SPROUT_MQTT_PORT=1883
SPROUT_MQTTS_PORT=8883

# ---- 实时语音（设备 WebSocket）----
# 默认关闭。开启前必须设置一个至少 32 字符的 WS_TOKEN_SECRET（与平台设备令牌
# 验签密钥一致），并至少配置一个 ASR 与一个 TTS 供应商，否则网关会拒绝启动实时
# 端点。供应商密钥只注入语音网关，不下发到设备或前端。
SPROUT_VOICE_GATEWAY_WS_ENABLED=false
SPROUT_VOICE_GATEWAY_WS_PATH=/v1/voice
SPROUT_VOICE_GATEWAY_WS_TOKEN_SECRET=
SPROUT_VOICE_GATEWAY_ASR_PROVIDER=
SPROUT_VOICE_GATEWAY_ASR_ENDPOINT=
SPROUT_VOICE_GATEWAY_ASR_API_KEY=
SPROUT_VOICE_GATEWAY_ASR_MODEL=
SPROUT_VOICE_GATEWAY_TTS_PROVIDER=
SPROUT_VOICE_GATEWAY_TTS_ENDPOINT=
SPROUT_VOICE_GATEWAY_TTS_API_KEY=
SPROUT_VOICE_GATEWAY_TTS_MODEL=
SPROUT_VOICE_GATEWAY_TTS_VOICE=
SPROUT_VOICE_GATEWAY_LLM_MODEL=

# ---- 发布文件服务 ----
# SFTP 只用于 GitHub Actions 上传。默认只监听本机，避免把上传入口暴露到公网；
# GitHub Actions 无法直接访问 127.0.0.1 时，必须在外层安全组仅放行固定出口，
# 再改为对应网卡地址，不能使用 0.0.0.0 对所有来源开放。
# HTTP 只提供只读下载，由 1Panel 反向代理并终止 HTTPS。
SPROUT_DOWNLOAD_SFTP_BIND_ADDRESS=127.0.0.1
SPROUT_DOWNLOAD_SFTP_PORT=2022
SPROUT_DOWNLOAD_HTTP_BIND_ADDRESS=127.0.0.1
SPROUT_DOWNLOAD_HTTP_PORT=8085
SPROUT_DOWNLOAD_SFTP_USER=sprout-release
SPROUT_DOWNLOAD_SFTP_UID=1001
# 下载目录由 SFTP 和后端共享；两个运行用户必须使用同一个可写组。
SPROUT_DOWNLOAD_SFTP_GID=1001
SPROUT_DOWNLOAD_SFTP_AUTHORIZED_KEYS_DIR=./download/sftp/authorized_keys
SPROUT_DOWNLOAD_PUBLIC_BASE_URL=https://download.clarkhub.cn

# ---- 镜像版本 ----
SPROUT_PLATFORM_VERSION=0.12.7
SPROUT_SUB2API_VERSION=0.2.17

# ---- 品牌级服务版本管理与自动升级 ----
# 管理端把检查请求和升级请求写入该目录，worker 只消费白名单请求。
# 该路径同时挂载给 device_platform 和 upgrade_worker，默认与 Compose 保持一致。
SPROUT_SERVICE_VERSION_STATE_DIR=/var/lib/sprout-upgrades
SPROUT_SERVICE_VERSION_HOST_CLOUD_DIR=/opt/1panel/apps/sprout/deploy/cloud
SPROUT_SERVICE_VERSION_STATE_UID=65532
SPROUT_SERVICE_VERSION_STATE_GID=65532
SPROUT_SERVICE_VERSION_CHECK_INTERVAL_SECONDS=60
SPROUT_SERVICE_VERSION_RELEASE_CACHE_SECONDS=300
SPROUT_SERVICE_VERSION_RELEASE_CATALOG_LIMIT=100
SPROUT_SERVICE_VERSION_POLL_INTERVAL_SECONDS=5
SPROUT_SERVICE_VERSION_MAX_REQUEST_BYTES=65536
SPROUT_UPGRADE_HEALTH_TIMEOUT_SECONDS=180
SPROUT_UPGRADE_PLATFORM_REPOSITORY=TissyBoxC/sprout-platform
SPROUT_UPGRADE_SUB2API_REPOSITORY=TissyBoxC/sprout-sub2api-fork
# 可选：GitHub API 限流较低时填写只读令牌；不要写入日志或提交到仓库。
SPROUT_SERVICE_VERSION_GITHUB_TOKEN=

# ---- 服务间共享密钥 ----
SPROUT_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# 发布流水线专用令牌。它只允许上传 release 文件和刷新索引，不能读取家庭或 AI 数据。
SPROUT_RELEASE_UPLOAD_TOKEN=replace-with-another-32-random-characters
SPROUT_AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
SPROUT_AI_CREDENTIAL_KEY=replace-with-at-least-32-random-characters
SPROUT_MFA_CREDENTIAL_KEY=replace-with-another-32-random-characters
SPROUT_AUTH_ACCESS_TOKEN_TTL=15m
SPROUT_AUTH_REFRESH_TOKEN_TTL=720h
SPROUT_MFA_CHALLENGE_TTL=5m

# ---- 家长手机号验证 ----
SPROUT_PHONE_VERIFICATION_MODE=disabled
SPROUT_ALLOW_LOCAL_SMS_BYPASS=false

# ---- AI 账号默认值 ----
SPROUT_AI_DEFAULT_BALANCE_USD=0
SPROUT_AI_DEFAULT_CONCURRENCY=1
SPROUT_AI_DEFAULT_MODELS=

# ---- 资源与客户端更新 ----
# 发布流水线会把 APK、资源包、服务端二进制和版本索引写入下载服务。
# 设备只访问公开的 HTTPS 下载地址，不会接触 SFTP 凭据。
SPROUT_OTA_MANIFEST_BASE_URL=https://download.clarkhub.cn
SPROUT_OTA_RESOURCE_BASE_URL=https://download.clarkhub.cn
SPROUT_OTA_CLIENT_BASE_URL=https://download.clarkhub.cn

# ---- Sub2API 出站域名白名单 ----
# 完整覆盖 Sub2API 的上游域名列表，不是追加。多个域名使用英文逗号分隔，
# 不要包含空格、协议或路径。必须包含全部实际使用的中转站域名。
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=sub.unsee.you,api.openai.com,api.anthropic.com,api.kimi.com,api.moonshot.ai,api.moonshot.cn,open.bigmodel.cn,api.minimaxi.com,api.minimax.io,opencode.ai,generativelanguage.googleapis.com,cloudcode-pa.googleapis.com,*.openai.azure.com

# ---- Sub2API ----
SPROUT_SUB2API_API_KEY=replace-with-key-that-exists-in-sub2api-database
# 公网域名统一维护在 ../public-endpoints.env。
SPROUT_SUB2API_ADMIN_EMAIL=admin@clarkhub.cn
SPROUT_SUB2API_ADMIN_PASSWORD=replace-with-strong-admin-password
SPROUT_SUB2API_JWT_SECRET=replace-with-at-least-32-random-characters
SPROUT_SUB2API_TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
SPROUT_TIMEZONE=Asia/Shanghai
