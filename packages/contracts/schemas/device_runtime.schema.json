{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/device_runtime.schema.json",
  "title": "Device runtime status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "heartbeat_id",
    "reported_at",
    "firmware_version",
    "connection",
    "network_quality",
    "time_sync",
    "offline"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "device_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "heartbeat_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "reported_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    },
    "firmware_version": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "transport"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "offline",
            "connecting",
            "online"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "none",
            "wifi",
            "cellular_4g"
          ]
        }
      }
    },
    "network_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rssi_dbm",
        "latency_ms",
        "packet_loss_percent"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "unknown",
            "poor",
            "fair",
            "good",
            "excellent"
          ]
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "packet_loss_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "time_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "last_synced_at",
        "offset_ms"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unsynchronized",
            "synchronizing",
            "synchronized"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "none",
            "sntp",
            "platform"
          ]
        },
        "last_synced_at": {
          "oneOf": [
            {
              "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset_ms": {
          "type": "integer",
          "minimum": -60000,
          "maximum": 60000
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "fallback_active",
        "pending_telemetry"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "online",
            "grace",
            "offline"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "none",
            "network_unavailable",
            "authentication_failed",
            "time_not_synchronized",
            "service_unavailable"
          ]
        },
        "fallback_active": {
          "type": "boolean"
        },
        "pending_telemetry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "provisioning": {
      "description": "Current network provisioning projection. The bounded event history is included only on the administrator provisioning snapshot; runtime status omits it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "wifi_configured",
        "session_state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unprovisioned",
            "provisioning",
            "provisioned"
          ]
        },
        "wifi_configured": {
          "type": "boolean"
        },
        "session_state": {
          "type": "string",
          "enum": [
            "ready",
            "reauth_required",
            "revoked"
          ]
        },
        "dropped_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "last_provisioned_at": {
          "oneOf": [
            {
              "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/provisioning_event"
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "newest_sequence",
        "dropped_boot_events",
        "boot_events",
        "latest_failure",
        "recovery_events",
        "interaction_events"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "newest_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "dropped_boot_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "boot_events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/boot_event"
          }
        },
        "latest_failure": {
          "oneOf": [
            {
              "$ref": "#/$defs/module_failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_events": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/recovery_event"
          }
        },
        "interaction_events": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/interaction_event"
          }
        }
      }
    }
  },
  "$defs": {
    "boot_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "sequence",
        "uptime_ms",
        "boot_count",
        "reset_reason",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{3,63}$"
        },
        "event_type": {
          "type": "string",
          "const": "boot"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "boot_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "reset_reason": {
          "type": "string",
          "maxLength": 24
        },
        "firmware_version": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
        }
      }
    },
    "module_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "sequence",
        "module_name",
        "error_code",
        "failure_count",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{3,63}$"
        },
        "event_type": {
          "type": "string",
          "const": "module_failure"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "module_name": {
          "type": "string",
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "maxLength": 32
        },
        "failure_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "firmware_version": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
        }
      }
    },
    "recovery_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "sequence",
        "module_name",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{3,63}$"
        },
        "event_type": {
          "type": "string",
          "const": "module_recovered"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "module_name": {
          "type": "string",
          "maxLength": 32
        },
        "firmware_version": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
        }
      }
    },
    "interaction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "sequence",
        "detail_code",
        "duration_ms",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{3,63}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "wake_detected",
            "wake_rejected",
            "button_gesture",
            "indicator_state",
            "factory_reset_requested",
            "factory_reset_cancelled",
            "factory_reset_completed",
            "factory_reset_failed"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "detail_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "firmware_version": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
        }
      }
    },
    "provisioning_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "sequence",
        "detail_code",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{3,63}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "provisioning_started",
            "wifi_configured",
            "wifi_failed",
            "binding_completed",
            "binding_removed",
            "network_reconnected",
            "network_lost",
            "time_synced",
            "auth_revoked",
            "auth_restored",
            "binding_confirmed",
            "binding_pending"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "detail_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "firmware_version": {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
        }
      }
    }
  }
}
